# OpenAI API Key for LiteLLM integration
OPENAI_API_KEY=your_openai_api_key_here

# Optional: You can also use other LLM providers supported by LiteLLM
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# Optional: choose ARCvisor's models (any LiteLLM model string; defaults in app/utils/llm_utils.py)
# ARCVISOR_MODEL=gpt-5                # one model for every step
# ARCVISOR_MODEL_RISKS=gpt-5          # or per step: DESCRIPTION, REPO, CAPABILITIES, RISKS
